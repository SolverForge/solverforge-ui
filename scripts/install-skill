#!/usr/bin/env sh
set -eu

# Install the bundled solverforge-ui agent skill by copying it into skill
# directories. There is no symlink and no shared/central location: each harness
# reads its own skills directory, and this script writes an independent copy into
# each one you select. Default targets are the user-scope directories for
# opencode, Claude Code, and the cross-harness Agent Skills standard.

usage() {
	cat <<'EOF'
Usage: scripts/install-skill [--only <harness>]... [--project <dir>]
                             [--dir <skills-dir>]... [--uninstall] [--list] [--help]

Copy skills/solverforge-ui into the skill directories agents scan. Nothing is
symlinked; every destination receives its own copy.

  --only <harness>  restrict to a harness (repeatable): opencode, claude, agents
  --project <dir>   install into a project instead of user scope; each selected
                    harness gets its own project directory:
                      opencode -> <dir>/.opencode/skills
                      claude   -> <dir>/.claude/skills
                      agents   -> <dir>/.agents/skills
  --dir <path>      copy into an explicit skills directory (repeatable); when
                    given, --only and --project are ignored
  --uninstall       remove previously installed copies
  --list            show destination directories and their install state
  --help            show this help

Default harnesses and their own user-scope skills directories:
  opencode  ~/.config/opencode/skills   (opencode)
  claude    ~/.claude/skills            (Claude Code)
  agents    ~/.agents/skills            (Agent Skills standard; opencode, Codex)
EOF
}

skill_name=solverforge-ui
receipt_name=.solverforge-ui-install
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
skill_src="$repo_root/skills/$skill_name"

[ -f "$skill_src/SKILL.md" ] || {
	echo "error: skill source not found at $skill_src/SKILL.md" >&2
	exit 1
}

if command -v sha256sum >/dev/null 2>&1; then
	sha256_tool=sha256sum
elif command -v shasum >/dev/null 2>&1; then
	sha256_tool=shasum
else
	echo "error: sha256sum or shasum is required to verify installed copies" >&2
	exit 1
fi

action=install
only=""
project=""
explicit_dirs=""

harness_global_dir() {
	case "$1" in
	opencode) printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" ;;
	claude) printf '%s' "$HOME/.claude/skills" ;;
	agents) printf '%s' "$HOME/.agents/skills" ;;
	esac
}

harness_project_dir() {
	case "$1" in
	opencode) printf '%s' "$project/.opencode/skills" ;;
	claude) printf '%s' "$project/.claude/skills" ;;
	agents) printf '%s' "$project/.agents/skills" ;;
	esac
}

while [ $# -gt 0 ]; do
	case "$1" in
	--uninstall) action=uninstall ;;
	--list) action=list ;;
	--project)
		shift
		[ -n "${1:-}" ] || { echo "error: --project expects a directory" >&2; exit 1; }
		project=$1
		[ -d "$project" ] || { echo "error: project directory '$project' does not exist" >&2; exit 1; }
		;;
	--dir)
		shift
		[ -n "${1:-}" ] || { echo "error: --dir expects a directory" >&2; exit 1; }
		explicit_dirs="$explicit_dirs
$1"
		;;
	--only)
		shift
		case "${1:-}" in
		opencode | claude | agents) only="$only $1" ;;
		*)
			echo "error: --only expects opencode, claude, or agents" >&2
			exit 1
			;;
		esac
		;;
	--help | -h) usage; exit 0 ;;
	*)
		echo "error: unknown option '$1'" >&2
		usage >&2
		exit 1
		;;
	esac
	shift
done

selected() {
	if [ -n "$only" ]; then
		case " $only " in
		*" $1 "*) return 0 ;;
		*) return 1 ;;
		esac
	fi
	return 0
}

payload_digest() {
	root=$1
	(
		cd "$root"
		find . ! -path "./$receipt_name" -print | LC_ALL=C sort | while IFS= read -r entry; do
			if [ -d "$entry" ] && [ ! -L "$entry" ]; then
				printf 'directory\t%s\n' "$entry"
			elif [ -f "$entry" ] && [ ! -L "$entry" ]; then
				printf 'file\t%s\t' "$entry"
				sha256 "$entry"
			else
				printf 'other\t%s\n' "$entry"
			fi
		done
	) | sha256
}

sha256() {
	if [ "$sha256_tool" = sha256sum ]; then
		sha256sum "$@" | awk '{ print $1 }'
	else
		shasum -a 256 "$@" | awk '{ print $1 }'
	fi
}

read_receipt_digest() {
	receipt=$1/$receipt_name
	[ -f "$receipt" ] && [ ! -L "$receipt" ] || return 1
	[ "$(sed -n '1p' "$receipt")" = "format=1" ] || return 1
	[ "$(sed -n '2p' "$receipt")" = "skill=$skill_name" ] || return 1
	digest=$(sed -n '3s/^digest=//p' "$receipt")
	[ "${#digest}" -eq 64 ] || return 1
	case "$digest" in *[!0-9a-f]*) return 1 ;; esac
	[ "$(wc -l < "$receipt" | tr -d ' ')" = 3 ] || return 1
	printf '%s' "$digest"
}

write_receipt() {
	{
		printf 'format=1\n'
		printf 'skill=%s\n' "$skill_name"
		printf 'digest=%s\n' "$2"
	} > "$1/$receipt_name"
}

classify_destination() {
	dest=$1
	if [ -L "$dest" ] || { [ -e "$dest" ] && [ ! -d "$dest" ]; }; then
		printf 'foreign-entry'
		return 0
	fi
	if [ ! -d "$dest" ]; then
		printf 'absent'
		return 0
	fi
	if [ ! -e "$dest/$receipt_name" ]; then
		printf 'unmanaged-directory'
		return 0
	fi
	if ! recorded_digest=$(read_receipt_digest "$dest"); then
		printf 'invalid-receipt'
		return 0
	fi
	actual_digest=$(payload_digest "$dest")
	if [ "$actual_digest" != "$recorded_digest" ]; then
		printf 'managed-modified'
	elif [ "$actual_digest" = "$source_digest" ]; then
		printf 'managed-current'
	else
		printf 'managed-outdated'
	fi
}

state_description() {
	case "$1" in
	absent) printf 'not installed' ;;
	foreign-entry) printf 'foreign entry present (left untouched)' ;;
	unmanaged-directory) printf 'unmanaged directory present (left untouched)' ;;
	invalid-receipt) printf 'invalid ownership receipt (left untouched)' ;;
	managed-modified) printf 'managed copy has local changes (left untouched)' ;;
	managed-current) printf 'managed copy present (current)' ;;
	managed-outdated) printf 'managed copy present (update available)' ;;
	esac
}

conflict_message() {
	label=$1
	dest=$2
	state=$3
	case "$state" in
	foreign-entry)
		echo "error: $dest is a file or symlink not managed by this installer; left untouched" >&2
		;;
	unmanaged-directory)
		echo "error: $dest has no ownership receipt; left untouched" >&2
		;;
	invalid-receipt)
		echo "error: $dest has an invalid ownership receipt; left untouched" >&2
		;;
	managed-modified)
		echo "error: $dest differs from its installation receipt; local changes were left untouched" >&2
		;;
	*) return 0 ;;
	esac
	printf 'conflict   %-9s %s\n' "$label" "$dest" >&2
}

install_into() {
	label=$1
	dir=$2
	state=$3
	install_dest="$dir/$skill_name"
	observed_state=$(classify_destination "$install_dest")
	if [ "$observed_state" != "$state" ]; then
		echo "error: $install_dest changed after preflight; left untouched" >&2
		exit 1
	fi

	if [ "$action" = uninstall ]; then
		case "$state" in
		managed-current | managed-outdated)
			rm -rf "$install_dest" && printf 'removed    %-9s %s\n' "$label" "$install_dest"
			;;
		esac
		return 0
	fi

	if [ "$state" = managed-current ]; then
		printf 'up-to-date %-9s %s\n' "$label" "$install_dest"
		return 0
	fi

	mkdir -p "$dir"
	active_stage=$(mktemp -d "$dir/.solverforge-ui.install.XXXXXX")
	cp -R "$skill_src/." "$active_stage/"
	write_receipt "$active_stage" "$source_digest"

	if [ "$state" = managed-outdated ]; then
		active_backup=$(mktemp -d "$dir/.solverforge-ui.backup.XXXXXX")
		rmdir "$active_backup"
		active_dest=$install_dest
		mv "$install_dest" "$active_backup"
		if ! mv "$active_stage" "$install_dest"; then
			mv "$active_backup" "$install_dest"
			active_backup=
			active_dest=
			exit 1
		fi
		active_stage=
		rm -rf "$active_backup"
		active_backup=
		active_dest=
	else
		mv "$active_stage" "$install_dest"
		active_stage=
	fi
	printf 'copied     %-9s %s\n' "$label" "$install_dest"
}

# Build the destination list in a temp file so the install loop runs in the
# current shell (an exit inside a pipeline would not stop the script).
dest_file=$(mktemp)
plan_file=$(mktemp)
active_stage=
active_backup=
active_dest=
cleanup() {
	status=$?
	trap - EXIT HUP INT TERM
	if [ -n "$active_backup" ] && [ -d "$active_backup" ]; then
		if [ -n "$active_dest" ] && [ ! -e "$active_dest" ] && [ ! -L "$active_dest" ]; then
			mv "$active_backup" "$active_dest" || true
		else
			rm -rf "$active_backup"
		fi
	fi
	[ -z "$active_stage" ] || rm -rf "$active_stage"
	rm -f "$dest_file" "$plan_file"
	exit "$status"
}
trap cleanup EXIT HUP INT TERM

if [ -n "$explicit_dirs" ]; then
	index=0
	printf '%s\n' "$explicit_dirs" | while IFS= read -r dir; do
		[ -n "$dir" ] || continue
		index=$((index + 1))
		printf 'custom-%s\t%s\n' "$index" "$dir"
	done > "$dest_file"
else
	for harness in opencode claude agents; do
		selected "$harness" || continue
		if [ -n "$project" ]; then
			dir=$(harness_project_dir "$harness")
		else
			dir=$(harness_global_dir "$harness")
		fi
		printf '%s\t%s\n' "$harness" "$dir" >> "$dest_file"
	done
fi

source_digest=$(payload_digest "$skill_src")
preflight_failed=0
while IFS="$(printf '\t')" read -r label dir; do
	[ -n "$label" ] || continue
	dest="$dir/$skill_name"
	state=$(classify_destination "$dest")
	printf '%s\t%s\t%s\n' "$label" "$dir" "$state" >> "$plan_file"
	if [ "$action" = list ]; then
		printf '%-9s %s  %s\n' "$label" "$dir" "$(state_description "$state")"
	elif [ "$state" = foreign-entry ] || [ "$state" = unmanaged-directory ] || \
		[ "$state" = invalid-receipt ] || [ "$state" = managed-modified ]; then
		conflict_message "$label" "$dest" "$state"
		preflight_failed=1
	fi
done < "$dest_file"

[ "$action" = list ] && exit 0
if [ "$preflight_failed" -ne 0 ]; then
	echo "error: no destinations were changed" >&2
	exit 1
fi

while IFS="$(printf '\t')" read -r label dir state; do
	[ -n "$label" ] || continue
	install_into "$label" "$dir" "$state"
done < "$plan_file"

if [ "$action" = install ]; then
	echo "done. restart your agent so it rescans skills."
fi
